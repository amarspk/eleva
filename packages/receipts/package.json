{
  "name": "@zayjar/receipts",
  "version": "1.0.0",
  "private": true,
  "description": "Shared customer receipt and kitchen ticket rendering for ELEVA (Phase 4 P3).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./receipt-config": {
      "types": "./dist/receipt-config.d.ts",
      "require": "./dist/receipt-config.js",
      "default": "./dist/receipt-config.js"
    },
    "./receipt-types": {
      "types": "./dist/receipt-types.d.ts",
      "require": "./dist/receipt-types.js",
      "default": "./dist/receipt-types.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\"",
    "test": "jest --config jest.config.js"
  },
  "dependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "typescript": "^5.4.5"
  }
}
