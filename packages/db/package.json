{
  "name": "@zayjar/db",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-generated-client.js",
    "lint": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\" --ignore-pattern \"src/generated-client/**\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "verify:partial-indexes": "node scripts/verify-partial-indexes.mjs",
    "db:health": "psql \"$DATABASE_URL\" -f scripts/db-health-checks.sql",
    "db:profile": "psql \"$DATABASE_URL\" -f scripts/query-profiling.sql",
    "db:optimize": "psql \"$DATABASE_URL\" -f scripts/optimize-tables.sql",
    "db:maintenance": "bash scripts/maintenance.sh --all",
    "db:migrate-status": "bash scripts/migrate-status.sh",
    "db:validate-migration": "bash scripts/migrate-validate.sh",
    "db:verify-backup": "bash scripts/migrate-backup-verify.sh",
    "db:post-migrate-check": "bash scripts/migrate-post-verify.sh",
    "db:backup": "bash scripts/backup-postgres.sh",
    "db:wal-archive": "bash scripts/wal-archive.sh",
    "db:verify-backups": "bash scripts/verify-backup-full.sh",
    "db:restore": "bash scripts/restore-postgres.sh"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
