{
  "name": "@zayjar/db",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-generated-client.js",
    "lint": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\" --ignore-pattern \"src/generated-client/**\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "db:health": "psql \"$DATABASE_URL\" -f scripts/db-health-checks.sql",
    "db:profile": "psql \"$DATABASE_URL\" -f scripts/query-profiling.sql",
    "db:optimize": "psql \"$DATABASE_URL\" -f scripts/optimize-tables.sql",
    "db:maintenance": "bash scripts/maintenance.sh --all"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
