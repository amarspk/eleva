# =============================================================================
# Zayjar Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Infrastructure — PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=zayjar_prod
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=CHANGEME_postgres_password

# -----------------------------------------------------------------------------
# Infrastructure — Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=CHANGEME_redis_password

# -----------------------------------------------------------------------------
# API Core — Server
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=8000

# -----------------------------------------------------------------------------
# API Core — Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres_admin:CHANGEME_postgres_password@pgbouncer:6432/zayjar_prod?sslmode=disable
DATABASE_READ_URL=postgresql://postgres_admin:CHANGEME_postgres_password@pgbouncer:6432/zayjar_prod?sslmode=disable

# -----------------------------------------------------------------------------
# API Core — Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://:CHANGEME_redis_password@redis-cache:6379

# -----------------------------------------------------------------------------
# API Core — Authentication (JWT)
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGEME_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGEME_jwt_refresh_secret_min_32_chars
JWT_PRIVATE_KEY=/run/secrets/jwt_private_key
JWT_PUBLIC_KEY=/run/secrets/jwt_public_key

# -----------------------------------------------------------------------------
# API Core — Security
# -----------------------------------------------------------------------------
SYSTEM_PEPPER=CHANGEME_system_pepper_min_32_chars

# -----------------------------------------------------------------------------
# Payment — Stripe
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_CHANGEME
STRIPE_WEBHOOK_SECRET=whsec_CHANGEME

# -----------------------------------------------------------------------------
# Payment — Tap Payments
# The secret API key also verifies Tap webhook `hashstring` signatures
# (POST /api/v1/payments/webhooks/tap).
# -----------------------------------------------------------------------------
TAP_PAYMENTS_SECRET_KEY=CHANGEME

# -----------------------------------------------------------------------------
# Storage — AWS S3
# -----------------------------------------------------------------------------
S3_BUCKET=zayjar-assets-production
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGEME
AWS_SECRET_ACCESS_KEY=CHANGEME

# -----------------------------------------------------------------------------
# DOC-007 §6.4 — CloudFront CDN
# -----------------------------------------------------------------------------
# When set (e.g. https://cdn.zayjar.com), media URLs in API responses are
# rewritten to route through CloudFront edge caching. Leave unset to serve
# images directly from S3.
CDN_BASE_URL=

# -----------------------------------------------------------------------------
# Notification — Twilio SMS
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=CHANGEME
TWILIO_AUTH_TOKEN=CHANGEME
TWILIO_FROM_NUMBER=+15005550006

# -----------------------------------------------------------------------------
# Notification — Unifonic SMS
# -----------------------------------------------------------------------------
UNIFONIC_APP_SID=CHANGEME
UNIFONIC_SENDER_ID=Zayjar

# -----------------------------------------------------------------------------
# Notification — SendGrid Email
# -----------------------------------------------------------------------------
SENDGRID_API_KEY=SG.CHANGEME
SENDGRID_FROM_EMAIL=noreply@zayjar.com

# AUDIT-005 — base URL for password-reset and email-verification links
# (paths: /reset-password?token=... and /verify-email?token=...).
# When unset, the verified tenant subdomain convention is used:
# https://<subdomain>.zayjar.com/<path>. Set this to the actual frontend
# host serving those pages before production use.
RESET_URL_BASE=

# AUDIT-005 — login email-verification gate.
# Production (NODE_ENV=production) requires emailVerified === true unless this
# is explicitly set to false. Dev/test stay open unless set to true.
REQUIRE_EMAIL_VERIFIED=

# -----------------------------------------------------------------------------
# DOC-006 §5.9 — AWS Secrets Manager
# -----------------------------------------------------------------------------
# When set, the application fetches secrets from AWS Secrets Manager at startup,
# overriding any values defined above. The secret must be a JSON document with
# key-value pairs matching the environment variable names (e.g.:
# {"DATABASE_URL": "...", "JWT_SECRET": "...", "STRIPE_SECRET_KEY": "..."}).
#
# In production (ECS/EKS), use IAM Task Execution Role for AWS authentication.
# No explicit AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY needed for Secrets Manager.
#
# For local development, leave this unset to use the .env values above.
AWS_SECRETS_MANAGER_SECRET_ID=

# ==========================================
# Firebase Cloud Messaging (Push Notifications)
# ==========================================
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ==========================================
# Next.js Client-Side Variables
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SOCKET_SERVER_URL=http://localhost:8000

# ==========================================
# Storage Provider (local | s3)
# ==========================================
STORAGE_PROVIDER=local

# ==========================================
# CORS
# ==========================================
CORS_ORIGIN=http://localhost:3000

# ==========================================
# CloudFront CDN (optional)
# ==========================================
CDN_BASE_URL=

# ==========================================
# Redis TLS (set to true for managed Redis)
# ==========================================
REDIS_TLS=false

# ==========================================
# Datadog APM (optional — production observability)
# ==========================================
DD_AGENT_HOST=
DD_SERVICE=zayjar-api
DD_ENV=production
DD_VERSION=1.0.0

# ==========================================
# Prometheus metrics (AUDIT-023)
# ==========================================
# Static bearer credential for GET /metrics (Authorization: Bearer <token>).
# When unset, /metrics fails closed with 503. Requests without or with a
# wrong token receive 401. Set this to a strong random value in production.
METRICS_TOKEN=

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=info
LOG_DIR=./logs
